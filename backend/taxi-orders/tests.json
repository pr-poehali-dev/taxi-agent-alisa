{
  "tests": [
    {
      "name": "POST create with valid body returns 200",
      "method": "POST",
      "path": "/?action=create",
      "body": {
        "passenger_name": "Иван Иванов",
        "passenger_phone": "+79001234567",
        "from_city": "Москва",
        "to_city": "Санкт-Петербург",
        "trip_date": "2026-07-01T10:00:00",
        "passengers_count": 2,
        "comment": "Тестовый заказ"
      },
      "expectedStatus": 200
    },
    {
      "name": "GET list without token returns 401",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 401
    }
  ]
}
